{
  "name": "cowboys-web-toolbox",
  "private": true,
  "version": "1.2.0",
  "description": "Static catalog and optional Supabase community",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "python3 build.py",
    "test": "node --test tests/*.test.mjs",
    "check:edge": "deno check --config supabase/functions/community-api/deno.json --node-modules-dir=manual --no-remote supabase/functions/community-api/index.ts supabase/functions/website-activity/index.ts supabase/functions/community-programs/index.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@supabase/supabase-js": "2.118.0",
    "deno": "2.9.6",
    "nodemailer": "10.2.1",
    "supabase": "2.122.0"
  }
}
